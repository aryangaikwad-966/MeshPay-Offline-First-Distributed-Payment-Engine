# Copy these local-demo values into a new, private .env file and replace them.
# These are development placeholders, not production credentials.
SPRING_PROFILES_ACTIVE=dev
DB_USER=syncpay
DB_PASSWORD=local-only-change-me
REDIS_PASSWORD=local-only-change-me
REDIS_PORT=6379
GRAFANA_ADMIN_PASSWORD=local-only-change-me

# Packet sync is disabled until a matching recipient key pair and trusted signer are provisioned.
SYNCPAY_PACKET_RSA_PRIVATE_KEY=
SYNCPAY_PACKET_RSA_PUBLIC_KEY=
SYNCPAY_PACKET_TRUSTED_SIGNERS=
SYNCPAY_PACKET_MAX_OFFLINE_AGE=30d

SYNCPAY_OUTBOX_MAX_RETRIES=10
SYNCPAY_OUTBOX_ENABLED=true

# Required for Payment/Saga/Gateway when SPRING_PROFILES_ACTIVE is not dev.
SYNCPAY_JWKS_URI=
SYNCPAY_JWT_ISSUER=
SYNCPAY_JWT_AUDIENCE=

# Browser origins allowed to call the services (comma-separated, exact match)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8080
